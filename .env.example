# WebZítra headless content (optional). When set, the page overlays
# WebZítra-edited content from app.webzitra.cz on top of the static
# Czech translations in app/i18n/translations.ts. When unset, the
# page falls back to the static document and runs entirely
# offline-friendly.
#
# - WEBZITRA_PROJECT_ID  : projects.id from WebZítra Supabase. Studio
#                          configures this once when the client is
#                          onboarded.
# - WEBZITRA_WEBHOOK_SECRET : project_content.webhook_secret from
#                             WebZítra. Used by /api/revalidate to
#                             verify webhook signatures.
# - WEBZITRA_API         : override for local dev / staging WebZítra
#                          deployment. Defaults to
#                          https://app.webzitra.cz/api/public/content.
WEBZITRA_PROJECT_ID=
WEBZITRA_WEBHOOK_SECRET=
# WEBZITRA_API=
